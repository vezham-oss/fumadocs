{
  "name": "@vx-oss/docs-openapi",
  "version": "1.0.17",
  "description": "Generate MDX docs for your OpenAPI spec",
  "keywords": [
    "Docs",
    "fumadocs"
  ],
  "homepage": "https://vezham.com",
  "license": "MIT",
  "author": "Vx OSS Devs <oss-developers@vezham.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham-oss/fumadocs",
    "directory": "packages/openapi"
  },
  "files": [
    "css",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./i18n": "./dist/i18n.js",
    "./playground/client": "./dist/playground/client.js",
    "./requests/generators": "./dist/requests/generators/index.js",
    "./requests/generators/all": "./dist/requests/generators/all.js",
    "./requests/generators/csharp": "./dist/requests/generators/csharp.js",
    "./requests/generators/curl": "./dist/requests/generators/curl.js",
    "./requests/generators/go": "./dist/requests/generators/go.js",
    "./requests/generators/java": "./dist/requests/generators/java.js",
    "./requests/generators/javascript": "./dist/requests/generators/javascript.js",
    "./requests/generators/python": "./dist/requests/generators/python.js",
    "./requests/generators/rust": "./dist/requests/generators/rust.js",
    "./scalar": "./dist/scalar/index.js",
    "./server": "./dist/server/index.js",
    "./ui": "./dist/ui/index.js",
    "./ui/base": "./dist/ui/base.js",
    "./ui/create-client": "./dist/ui/create-client.js",
    "./package.json": "./package.json",
    "./css/*": "./css/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@fuma-translate/react": "^1.0.2",
    "@fumadocs/api-docs": "workspace:@vx-oss/docs-api@*",
    "@fumari/json-schema-ts": "^1.0.2",
    "@fumari/stf": "workspace:@vx-oss/docs-stf@*",
    "@scalar/json-magic": "^0.13.3",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "fumadocs-ui": "workspace:@vx-oss/docs-base-ui@*",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.39.0",
    "remark": "^15.0.1",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@scalar/api-client-react": "^2.0.43",
    "@scalar/openapi-upgrader": "^0.2.15",
    "@tailwindcss/oxide": "^4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "fast-content-type-parse": "^4.0.0",
    "fuma-cli": "^0.1.1",
    "fumadocs-core": "workspace:@vx-oss/docs-core@*",
    "json-schema-typed": "^8.0.2",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "xml-js": "^1.6.11"
  },
  "peerDependencies": {
    "@scalar/api-client-react": "^2.0.20",
    "@types/react": "*",
    "fumadocs-core": "*",
    "json-schema-typed": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "json-schema-typed": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "@scalar/api-client-react": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "@scalar/openapi-upgrader": "0.2.15",
    "fast-content-type-parse": "4.0.0",
    "xml-js": "1.6.11"
  }
}
