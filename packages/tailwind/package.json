{
  "name": "@vx-oss/docs-tailwind",
  "version": "1.0.16",
  "description": "The Tailwind CSS utils for Fumadocs UI.",
  "keywords": [
    "Docs",
    "Fumadocs"
  ],
  "homepage": "https://vezham.com",
  "license": "MIT",
  "author": "Vx OSS Devs <oss-developers@vezham.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham-oss/fumadocs",
    "directory": "packages/tailwind"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./typography": "./dist/typography/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@fastify/deepmerge": "^3.2.1",
    "@types/node": "^26.4.1",
    "postcss-selector-parser": "^7.1.5",
    "tailwindcss": "^4.3.3",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "@fastify/deepmerge": "3.2.1",
    "cssesc": "3.0.0",
    "postcss-selector-parser": "7.1.6",
    "util-deprecate": "1.0.2"
  }
}
