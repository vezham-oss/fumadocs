{
  "name": "@vx-oss/docs-local-content",
  "version": "1.0.16",
  "description": "Shared building blocks for local content sources in Fumadocs",
  "keywords": [
    "Docs",
    "fumadocs"
  ],
  "homepage": "https://vezham.com",
  "license": "MIT",
  "author": "Vx OSS Devs <oss-developers@vezham.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham-oss/fumadocs",
    "directory": "packages/local-content"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./dev/vite": "./dist/dev/vite/index.js",
    "./dev/ws": "./dist/dev/ws/index.js",
    "./dev/ws/react": "./dist/dev/ws/react.js",
    "./dev/ws/server": "./dist/dev/ws/server.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "test": "vitest run",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.18.1",
    "fumadocs-core": "workspace:@vx-oss/docs-core@*",
    "react": "^19.2.8",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@types/react": "*",
    "fumadocs-core": "*",
    "react": "^19.2.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
